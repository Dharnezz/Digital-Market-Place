# Local development environment sample. Copy to .env (gitignored) or set in your shell.
# Production values are set per platform (Render dashboard / Vercel env / docker-compose).

# Full JDBC url overrides DB_HOST / DB_PORT / DB_NAME (defaults: 127.0.0.1:5432/digitalmarketplace)
# DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/digitalmarketplace
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=digitalmarketplace
DB_USERNAME=postgres
# DB_PASSWORD=

# JWT signing secret — MUST be unique and >= 32 bytes in production.
JWT_SECRET=dev-only-jwt-secret-change-me-in-production-0123456789
JWT_EXPIRATION_MS=86400000

# Comma-separated browser origins allowed to call the API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Seed demo users/products on a fresh database (dev only).
APP_DEMO_DATA_ENABLED=true

# Server port (Docker/Render inject PORT).
PORT=8080